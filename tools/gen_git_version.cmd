@echo off
rem ============================================================
rem  gen_git_version.cmd - Generate git_version.h with the current
rem  git commit hash and remote repository URL for the About dialog.
rem
rem  Usage: gen_git_version.cmd <output header path>
rem
rem  - Falls back to "unknown" when git is not installed or the
rem    source is not a git repository.
rem  - Only rewrites the output when its content actually changed,
rem    so incremental builds are not disturbed.
rem ============================================================
setlocal
set "OUTFILE=%~1"
set "TMPFILE=%~1.tmp"
set "HASH=unknown"
set "REPO_URL=unknown"

for /f "tokens=*" %%i in ('git rev-parse --short HEAD 2^>nul') do set "HASH=%%i"
for /f "tokens=*" %%i in ('git config --get remote.origin.url 2^>nul') do set "REPO_URL=%%i"

> "%TMPFILE%" echo // Auto-generated by tools\gen_git_version.cmd - do not edit
>> "%TMPFILE%" echo #ifndef GIT_VERSION_H
>> "%TMPFILE%" echo #define GIT_VERSION_H
>> "%TMPFILE%" echo #define GIT_COMMIT_HASH "%HASH%"
>> "%TMPFILE%" echo #define GIT_REPO_URL "%REPO_URL%"
>> "%TMPFILE%" echo #endif

rem Update the output file only when content changed
fc /b "%OUTFILE%" "%TMPFILE%" >nul 2>&1
if errorlevel 1 (
  move /y "%TMPFILE%" "%OUTFILE%" >nul
) else (
  del "%TMPFILE%" >nul 2>&1
)
exit /b 0
